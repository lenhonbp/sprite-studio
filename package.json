{
  "name": "nhon-le-sprite-studio",
  "version": "4.1.1",
  "private": false,
  "type": "module",
  "optionalDependencies": {
    "@napi-rs/canvas": "^0.1.80"
  },
  "scripts": {
    "build": "python3 scripts/sync-shared.py && python3 build-offline.py && python3 scripts/build-worker.py && bash scripts/build.sh && node scripts/validate-artifact.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:canvas": "node test-editor.mjs && STUDIO_OFFLINE=1 node test-editor.mjs && node --test cli/scripts/test-rig.mjs cli/scripts/test-v2.mjs",
    "start": "node local/server.mjs",
    "studio": "node local/studio-cli.mjs",
    "mcp": "node local/mcp-stdio.mjs",
    "rig": "node cli/scripts/rig-tool.mjs",
    "art": "node scripts/art.mjs",
    "test:skill": "node scripts/test-skill.mjs",
    "audit": "python3 scripts/audit-bundle.py",
    "test:field": "node test-field.mjs && node test-field-production.mjs",
    "production": "node scripts/production-cli.mjs",
    "test:production": "node --test test-production.mjs",
    "test:engines": "node --test test-engines.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "test:handoff": "node --test test-handoff.mjs && python3 scripts/test_release.py"
  },
  "description": "AI-assisted sprite, rig-animation and VFX production studio for games",
  "author": "Nhon Le",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lenhonbp/sprite-studio.git"
  }
}